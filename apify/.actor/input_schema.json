            "type": "string",
            "description": "Your point, e.g. «40.4168». Adds the distance in km to every station and enables the radius filter.",
            "editor": "textfield",
            "sectionCaption": "Near a location"
        },
        "longitude": {
            "title": "Longitude",
            "type": "string",
            "description": "Your point, e.g. «-3.7038».",
            "editor": "textfield"
        },
        "radiusKm": {
            "title": "Radius (km)",
            "type": "integer",
            "description": "Only stations within this distance of the point above.",
            "editor": "number",
            "minimum": 1,
            "maximum": 1000
        },
        "sortBy": {
            "title": "Sort by",
            "type": "string",
            "description": "Order of the results.",
            "editor": "select",
            "enum": [
                "none",
                "price",
                "distance"
            ],
            "enumTitles": [
                "Official order",
                "Cheapest first (first selected fuel, or Gasoline 95 E5)",
                "Nearest first (needs latitude and longitude)"
            ],
            "default": "none",
            "sectionCaption": "Output"
        },
        "maxResults": {
            "title": "Maximum results",
            "type": "integer",
            "description": "Stop after this many stations (0 = no limit). Combine with «Cheapest first» to get e.g. the 10 cheapest stations.",
            "editor": "number",
            "minimum": 0,
            "default": 0
        },
        "date": {
            "title": "Historical date",
            "type": "string",
            "description": "Get the official closing prices of a past day (YYYY-MM-DD). Leave empty for the current live prices.",
            "editor": "datepicker"
        },
        "includeRestrictedSale": {
            "title": "Include restricted-sale stations",
            "type": "boolean",
            "description": "Also include stations that only sell to members or fleets (not open to the public).",
            "editor": "checkbox",
            "default": false
